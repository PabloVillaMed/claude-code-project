{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // `node` lo necesitan solo las pruebas (leen el disco para comprobar
    // que las fotos referenciadas existen de verdad). No viaja en el bundle.
    "types": ["vitest/globals", "node"]
  },
  "include": ["src"]
}
