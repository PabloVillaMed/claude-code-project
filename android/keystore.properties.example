# Copia este archivo a keystore.properties y ajusta los valores.
# Genera el keystore con:
#   keytool -genkeypair -v -keystore parches-release.keystore -alias parches \
#     -keyalg RSA -keysize 2048 -validity 10950
storeFile=parches-release.keystore
storePassword=CAMBIA_ESTO
keyAlias=parches
keyPassword=CAMBIA_ESTO
